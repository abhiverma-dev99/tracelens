// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

// URL property is intentionally removed for Prisma v7+
datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Project {
  id          String       @id @default(uuid())
  name        String
  ingestKey   String       @unique @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  incidents   Incident[]
  deployments Deployment[]
  createdAt   DateTime     @default(now())
}

model Incident {
  id          String   @id @default(uuid())
  message     String
  service     String
  stackTrace  String?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // AI fields (By String? we mean it's optional)
  aiRootCause String?
  aiSolution  String?

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Deployment {
  id          String   @id @default(uuid())
  commitHash  String
  message     String
  author      String
  repository  String
  branch      String
  deployedAt  DateTime @default(now())

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}